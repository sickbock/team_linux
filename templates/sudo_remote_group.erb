# Allow $module_name users elevated privileges
<% if @sudo_users -%>
<% if @sudo_role_t %>
# team based rules
<% @sudo_users.each do |val| -%>
<% @sudo_role_t.each do |stuser|-%>
<%= val %> <%= @shortname %>=(ALL) NOPASSWD: /bin/su - <%= stuser %>
<% end -%>
<% end -%>
<% end -%>
<% end -%>

<% if @sudo_users -%>
<% if @sudo_role_r %>
# role based rules
<% @sudo_users.each do |val| -%>
<% @sudo_role_r.each do |sruser|-%>
<%= val %> <%= @shortname %>=(ALL) NOPASSWD: /bin/su - <%= sruser %>
<% end -%>
<% end -%>
<% end -%>
<% end -%>


## puppet master : <%= @servername %>
## puppet version: <%= @serverversion %>
## puppet module : <%= @module_name %>
## puppet class  : <%= @name %>
## do not edit this file.
## Documentation:
##  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>

# Legacy settings
# reduce duplicate log messages (last message repeated n times)
#action.repeatedmsgcontainsoriginalmsg="on"
$RepeatedMsgReduction on
# Queue type Disk, LinkedList, ...
#queue.type="LinkedList"
$ActionQueueType LinkedList
# Activate and save queues 
#queue.filename="local_msg"
$ActionQueueFileName local_msg
#queue.saveOnShutdown="on"
$ActionQueueSaveOnShutdown on
# Leave other settings default 

# Most likely the "-" preceding the file path has no meaning here 
# In a legacy configuration with '$ActionFileEnableSync on' on top it will disable sync for the file following the directive
# https://www.rsyslog.com/doc/v8-stable/configuration/actions.html#regular-file

# Log all kernel messages to the console.
# Logging much else clutters up the screen.
kern.*                                                  -/var/log/kern.log

# Log anything (except mail) of level info or higher.
# Don't log private authentication messages!
# exclude local3, we use it for remote audit logging
# exclude daemon, log it to a separate file
*.info;mail.none;authpriv.none;cron.none;\
  daemon.none;local3.none                               /var/log/messages

# The authpriv file has restricted access.
authpriv.*                                              /var/log/secure

# Log all the mail messages in one place.
mail.*                                                  -/var/log/maillog

# Log cron stuff
cron.*                                                  /var/log/cron

# Save news errors of level crit and higher in a special file.
uucp,news.crit                                          /var/log/spooler

# Save boot messages also to boot.log
local7.*                                                /var/log/boot.log

# severity level debug goes to
*.=debug;auth,authpriv.none;news.none;mail.none         -/var/log/debug 

# all in facility daemon goes to
daemon.*                                               -/var/log/daemon.log

# all in facility lpr goes to
lpr.*                                                  -/var/log/lpr.log

# all in facility user goes to
user.*                                                 -/var/log/user.log

# Everybody gets emergency messages
*.emerg action(type="omusrmsg" users="*")

## Deep Security agents:
## https://success.trendmicro.com/dcx/s/solution/1096332-enabling-detailed-logging-on-deep-security-agent-dsa?language=en_US
#local0.info                                             /var/log/deepsec
#local0.*                                                /var/log/deepsec


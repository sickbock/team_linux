## puppet master : <%= @servername %>
## puppet version: <%= @serverversion %>
## puppet module : <%= @module_name %>
## puppet class  : <%= @name %>
## do not edit this file.
## Documentation:
##  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>

<% if @noderole != 'rsyslogserver' -%>
# certificate files - just CA for a client
global(DefaultNetstreamDriverCAFile="/etc/rsyslog.d/ca.pem")
<% end -%>

<% if @rsyslprotocol == 'tcp' -%>
# set up the action for all messages
*.* action(type="omfwd"
       queue.type="linkedlist"
       queue.filename="msg_fwd"
       action.resumeRetryCount="-1"
       queue.saveOnShutdown="on"
       protocol="tcp" target="<%= @rsyslogserver %>" port="514"
       StreamDriver="gtls" StreamDriverMode="1" StreamDriverAuthMode="anon")
<% end -%>

<% if @rsyslprotocol == 'relp' -%>
module(load="omrelp")
*.* action(type="omrelp"
       target="<%= @rsyslogserver %>" port="6514"
       # Queue to disk if needed
       queue.type="LinkedList"
       queue.filename="relp_fwd"
       queue.saveonshutdown="on"
       queue.maxdiskspace="1g"

       action.resumeRetryCount="-1"
       action.reportsuspension="on"

       # and send over encrypted link always
       tls="on"

       # currently rsyslog cannot provide intermediates from server end
       # so we need the full chain wherever validation is required
       tls.cacert      = "/etc/rsyslog.d/ca.pem"
       tls.mycert      = "/etc/rsyslog.d/host-cert.pem"
       tls.myprivkey   = "/etc/rsyslog.d/host-key.pem"

       tls.authmode="name"
       tls.permittedpeer=["<%= @rsyslogserver %>"]
       )
<% end -%>

<% if @rsyslprotocol == 'udp' -%>
# No UDP reception enegled on the server at this time
<% end -%>

#local3.* @<%= @rsyslogserver %>:514

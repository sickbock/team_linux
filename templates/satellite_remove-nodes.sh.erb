#PURPOSE: Removing nodes from satellite database as supplied by puppet/voxpopuli server.
#MAILEE=DG-ICT-Services-Team-Linux@hetcak.nl
MAILEE="linuxbeheer@hetcak.nl mpost@hetcak.nl"
#MAILEE=roostendorp@hetcak.nl
SCRIPTNAME=${0}
INDIR='/data/remove-nodes-imported/'
LOGDIR='/data/remove-nodes-logging/'
NOTDIR='/data/remove-nodes-notinsatellite/'

for i in $(ls ${INDIR})
do
# search server in sattelite CAK organization.
hostexist=$(hammer host list --organization="CAK"|grep $i|awk '{print $3}')
	if [ "$hostexist" = "$i" ]; then   
	echo "------------------------------------------------------------------" >> ${LOGDIR}removed-nodes.log
	date >> ${LOGDIR}removed-nodes.log
	echo $i >> ${LOGDIR}removed-nodes.log 
	hammer host delete --name $i 2>&1 > /dev/null
          if [ "$?" == "0" ] ; then
            mail -s "${LOGDIR}remove-nodes.sh" $MAILEE << EOF

Host $i has been removed from Satellite. (Initiated via signal file)
EOF
          fi
	rm -rf ${INDIR}$i
	else
        mail -s "${SCRIPTNAME}" $MAILEE << EOF
Node " $i " not found in satellite. server not removed.
EOF
	echo "server " $i " not found in satellite. server not removed" >> ${LOGDIR}removed-nodes.log
	mv ${INDIR}$i ${NOTDIR}
	fi
done

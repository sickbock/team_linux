#!/bin/bash 
################################################################################
# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
#
# Replace core functionality of "linuxaccess sudo configuration" while needed
#
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>
################################################################################
#PURPOSE: Mail overview of hypervisor subscriptions

#BASEDIR=/root/scripts/hypervisor-subscription-overview/
BASEDIR=/root/output
DATE=`date '+%d%m%y'` #020919 
OUTPUT=host_and_dc-$DATE.csv
MAILEE=linuxbeheer@hetcak.nl
#MAILEE=roostendorp@hetcak.nl
MAILLOG=maillog
LOG=logfile-$DATE
MAILTOPIC=virtwho-output

cleanup() {
rm -f $LOG
rm -f $MAILLOG
find $BASEDIR -name \*host_and_dc\* -ctime +7 -exec rm {} \;
}

trap_action()
{
echo "Script interrupted with Ctrl-C...please rerun, or manually cleanup leftovers" >> $MAILLOG
exit_action
}

exit_action()
{
echo "`date +%H:%M:%S`: Exiting" >> $MAILLOG
echo "`date +%H:%M:%S`: Exiting"
echo "" >> $MAILLOG
echo "$ERROR" >> $MAILLOG
echo "" >> $MAILLOG 
mailx -s "FAILED: $MAILTOPIC" $MAILEE < $MAILLOG           
exit 1
}
trap trap_action HUP INT QUIT TERM 


## 
# check if we are in the correct place
cd $BASEDIR > /dev/null 2>&1|| { ERROR="BASEDIR $BASEDIR does not exist"  ; exit_action; }


####  if $1 is refresh
if [ "$1" == "refresh" ] 
then 
test -f $OUTPUT && rm $OUTPUT
fi



## if no export exists today, lets create it
if ! test -f $OUTPUT ; then
# dit report is het originele 'registered hosts' rapport, maar met in column-2 op welke host de vm draait.
hammer report-template generate --name "Registered hosts and their DC" > $OUTPUT  || { ERROR="hammer command failed"  ; exit_action; }
fi

# show current use of vdc's
echo "Current Status of vdc subscriptions on `date`"| tee -a $LOG
echo| tee -a $LOG

# show amount of visible hypervisors on the satellite
echo "Number of Active Hypervisors : `hammer report-template generate --name "Registered hosts" --inputs "Hosts filter =  hypervisor = true" | sed -n '1!p' | wc -l`" | tee -a $LOG
echo| tee -a $LOG

echo "=== Red Hat Enterprise Linux for Virtual Datacenters with Smart Management, Premium ===" | tee -a $LOG
echo | tee -a $LOG
hammer subscription list --organization "CAK Satellite" | egrep "CONTRACT|Virtual Datacenters"  | egrep "CONTRACT|Physical" | awk -F"|" '{print $1" "$6" "$5" "$8" "$9" "$10}'| tee -a $LOG
echo | tee -a $LOG

### create array of esx hosts without esx subscription

NOSUBS="`grep ^virt $OUTPUT | grep -v "Virtual Datacenters with Smart Management" | awk -F"," '{print $1}'`"

echo "=== ESX Hosts without VDC Subscription and the (amount of) hosts connected ==="| tee -a $LOG
echo | tee -a $LOG
for y in $NOSUBS
do

HOSTS="`grep $y $OUTPUT | grep -v ^virt  | awk -F, '{print $1}' | wc -l`"

if [ "$HOSTS" != "0" ] ; then
echo "$y: $HOSTS"| tee -a $LOG
echo "`grep $y $OUTPUT | grep -v ^virt  | awk -F, '{print $1}'`"| tee -a $LOG
else
echo "$y: $HOSTS"| tee -a $LOG
fi
done
echo| tee -a $LOG
echo "=== ESX hosts with Valid VDC subscription and no hosts connected ==="| tee -a $LOG
echo | tee -a $LOG
SUBS="`grep ^virt $OUTPUT | grep "Virtual Datacenters with Smart Management" | awk -F"," '{print $1}'`"

for y in $SUBS
do
HOSTS="`grep $y $OUTPUT | grep -v ^virt  | awk -F, '{print $1}' | wc -l`"

if [ "$HOSTS" == "0" ] ; then
echo "$y: $HOSTS"| tee -a $LOG
# echo "`grep $y $OUTPUT | grep -v ^virt  | awk -F, '{print $1}'`"
fi
done

echo "

====================================================================
This script runs from the satellite server itself (`hostname`)
location : /root/scripts/hypervisor-subscription-overview
triggered by the crontab of root
====================================================================
" >> $LOG




mailx -r "`whoami`@`hostname`" -s "Hypervisor consumption overview `LC_ALL=nl_NL.utf8  date '+%d %B %Y'`" $MAILEE < $LOG           

# cleanup leftovers
cleanup


#/bin/sh

# generate a json list of scsi (sd driver) devices.

FIRST=1
echo "{"
echo "  \"data\":["
for scsi_disk in $(ls -1 /sys/block | grep '^sd[[:alpha:]]\{1,2\}')
do
<% if @facts['osfamily'] == 'Suse' -%>
  MAJMIN=$(cat /sys/block/${scsi_disk}/dev)
  UDEVDISK="/dev/.udev/db/b${MAJMIN}"
<% elsif @facts['osfamily'] == 'RedHat' and @facts['os']['release']['major'] == '7' -%>
  MAJMIN=$(cat /sys/block/${scsi_disk}/dev)
  UDEVDISK="/var/run/udev/data/b${MAJMIN}"
<% else -%>
  UDEVDISK="/dev/.udev/db/block:$scsi_disk"
<% end -%>
  WWN=$(grep '^E:ID_WWN_WITH_EXTENSION' ${UDEVDISK} | cut -d\= -f2)
  MODEL=$(grep 'E:ID_MODEL=' ${UDEVDISK} | cut -d\= -f2)
  SECTOR_SIZE=$(cat /sys/block/${scsi_disk}/queue/hw_sector_size)
  SECTORS=$(cat /sys/block/${scsi_disk}/size)
  SIZE=$(expr $SECTORS \* $SECTOR_SIZE \/ 1024 \/ 1024 \/ 1024)
  if [ $FIRST -eq 1 ]; then
    echo -n "     "
    FIRST=0
  else
    echo -n "    ,"
  fi
  echo "{ \"{#DISKNAME}\":\"$scsi_disk\", \"{#WWN}\":\"$WWN\", \"{#MODEL}\":\"$MODEL\", \"{#SIZEGB}\":\"$SIZE\", \"{#SECTOR}\":\"$SECTOR_SIZE\" }"
done
echo  "  ]"
echo  "}"

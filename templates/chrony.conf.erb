# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>

<% @ntp_servers.each do |val| -%>
server <%= val %> iburst
<% end -%>

<%- if @facts['os']['release']['major'] < '8' -%> 
driftfile <%= @driftfile %>
makestep 1.0 3
logchange 0.5
logdir /var/log/chrony
bindcmdaddress 127.0.0.1
bindcmdaddress ::1
rtcsync
keyfile /etc/chrony.keys
<%- else -%>
driftfile <%= @driftfile %>
makestep 1.0 3
rtcsync
keyfile /etc/chrony.keys
leapsectz right/UT
logdir /var/log/chrony
<%- end -%>

# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>

# Generic settings
myhostname = <%= @facts['networking']['hostname'] %>
myorigin = <%= @facts['networking']['fqdn'] %>
relayhost = <%= @smtp_relay %>
inet_interfaces = <%= @inet_interfaces %>
mydestination = localhost, localhost.localdomain, <%= @facts['networking']['hostname'] %>.localdomain, <%= @facts['networking']['fqdn'] %>
data_directory = /var/lib/postfix
queue_directory = /var/spool/postfix
message_size_limit = 30720000

<%- if @osfamily == 'Suse' -%>
daemon_directory = /usr/lib/postfix
program_directory = /usr/lib/postfix
<%- else -%>
daemon_directory = /usr/libexec/postfix
command_directory = /usr/sbin
<%- end -%>

<%- if @osfamily == 'Suse' -%>
setgid_group = maildrop
<%- else -%>
setgid_group = postdrop
<%- end -%>

# Disable local alias lookups
alias_maps =
alias_database =
allow_mail_to_commands =
allow_mail_to_files =
virtual_alias_maps =
virtual_alias_domains =

# lets not give a banner who we are
# but it must not be empty either as that
# causes fatals on some nodes
smtpd_banner = anonymous

<%- if @mynetworks -%>
mynetworks = <%= @mynetworks %>
<%- end -%>

# Allow connections from trusted networks only; reject all others
smtpd_client_restrictions = permit_mynetworks, reject

# Don't accept mail from domains that don't exist.
# Disabled on Bart Jan's request
# smtpd_sender_restrictions = reject_unknown_sender_domain

# Whitelisting: local clients may specify any destination domain.
smtpd_recipient_restrictions = permit_mynetworks, reject_unauth_destination

# Block clients that speak too early.
smtpd_data_restrictions = reject_unauth_pipelining

# Added these settings to be backwards compatible with previous settings
sendmail_path = /usr/sbin/sendmail.postfix
sample_directory = /usr/share/doc/postfix-2.6.6/samples
relay_domains = $mydomain
readme_directory = /usr/share/doc/postfix-2.6.6/README_FILES
newaliases_path = /usr/bin/newaliases.postfix
mailq_path = /usr/bin/mailq.postfix
manpage_directory = /usr/share/man

#  systemd configuration for sonarqube to be installed in:
#       /opt/sonarqube/sonarqube (symbolic link to latest version)
#
# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
#
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>

export HTTP_PROXY=http://<%= @httpproxyserver %>
export HTTPS_PROXY=http://<%= @httpproxyserver %>
export http_proxy=http://<%= @httpproxyserver %>
export https_proxy=http://<%= @httpproxyserver %>
export NO_PROXY='127.0.0.1,localhost,.cak-bz.local,.ipaprod.hetcak.nl'
export no_proxy='127.0.0.1,localhost,.cak-bz.local,.ipaprod.hetcak.nl'

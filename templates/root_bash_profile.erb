# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>
# .bash_profile

# Get the aliases and functions
if [ -f ~/.bashrc ]; then
  . ~/.bashrc
fi

# User specific environment and startup programs

<%- if @scriptroot != 'not_set' -%>
PATH=$PATH:/root/bin:<%= @root_paths %>
if ! echo $PATH | grep -q "<%= @root_paths %>" ; then
  export PATH=$PATH:<%= @root_paths %>
fi
<%- else -%>
PATH=$PATH:/root/bin
<%- end -%>

export PATH

set -o vi


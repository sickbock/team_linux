# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>
/var/log/monitor-warning
/var/log/monitor-error
/var/log/monitor-critical
{
  sharedscripts
  missingok
  create 640 root zabbix
  postrotate
    /bin/kill -HUP `cat <%= @syslog_pidfile %> 2> /dev/null` 2> /dev/null || true
  endscript
}

/var/log/insightsclient.log
{
  monthly
  missingok
  rotate 4
  compress
  create 640 root zabbix
  postrotate
    /bin/kill -HUP `cat <%= @syslog_pidfile %> 2> /dev/null` 2> /dev/null || true
  endscript
}


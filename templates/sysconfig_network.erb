# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>

NETWORKING=yes
HOSTNAME=<%= @facts['networking']['fqdn'] %>
GATEWAYDEV=<%= @facts['networking']['primary'] %>
<%- if @facts['customgateway'] -%>
GATEWAY=<%= @facts['customgateway'] %>
<%- end -%>
<%- if @ipaclient == true -%>
NISDOMAIN=<%= @ipa_domainname %>
<%- end -%>
NOZEROCONF=yes

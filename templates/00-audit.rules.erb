# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>

# remove any existing rules
-D

# buffer size
-b 8192

## Set failure mode to NOT panic
## since it may panic RHEL6 vm's during
## vmware snapshot creation
-f 1

# do not fail on rules set on files that do not exist
-i

<%- @audit_rules.sort.each do |key,rules| -%>
# <%= key %>
<%- rules.each do |line| -%>
<%= line %>
<%- end -%>

<%- end -%>

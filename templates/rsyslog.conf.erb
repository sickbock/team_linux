## puppet master : <%= @servername %>
## puppet version: <%= @serverversion %>
## puppet module : <%= @module_name %>
## puppet class  : <%= @name %>
## do not edit this file.
## Documentation:
##  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>
#
# https://www.rsyslog.com/doc/v8-stable/configuration/modules/imuxsock.html#imuxsock-systemd-details-label
#   See "Coexistence with systemd", working configuration example:
# https://github.com/rsyslog/rsyslog/issues/2150
global (
    action.reportSuspension="on"
    action.reportSuspensionContinuation="on"
    workDirectory="/var/lib/rsyslog"
    processInternalMessages="off"
<% unless @rsyslog_maxmsgsz.nil? -%>
    maxMessageSize="<%= @rsyslog_maxmsgsz %>"
<% end -%>
)

# local messages are retrieved through imjournal now.
<%- if @osfamily == 'RedHat' and @facts['os']['release']['major'] < '8' -%>
$ModLoad imuxsock.so   # provides support for local system logging (e.g. via logger command)
<%- elsif @osfamily == 'RedHat' and @facts['os']['release']['major'] >= '8' -%>
module(load="imuxsock" SysSock.Use="off")
module(load="imjournal" StateFile="imjournal.state" ratelimit.interval="0" Ratelimit.Burst="0")
module(load="mmjsonparse")
<%- end -%>

module(load="imklog")   # provides kernel logging support (previously done by rklogd)

module(load="immark")  # provides --MARK-- message capability

module(load="builtin:omfile" Template="RSYSLOG_FileFormat")

<%- if @osfamily == 'RedHat' and @facts['os']['release']['major'] < '8' -%>
$IncludeConfig /etc/rsyslog.d/*.conf
<%- elsif @osfamily == 'RedHat' and @facts['os']['release']['major'] >= '8' -%>
include(file="/etc/rsyslog.d/*.conf")
<%- end -%>


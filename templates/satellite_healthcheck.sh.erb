# puppet class  : <%= @name %>
# do not edit this file.
#
# Replace core functionality of "linuxaccess sudo configuration" while needed
#
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>

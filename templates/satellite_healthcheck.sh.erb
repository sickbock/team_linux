#PURPOSE: Mail healthcheck of satellite system
#set -x
BASEDIR="/var/tmp/${0##*/}/output"
echo $BASEDIR
cd $BASEDIR || { mkdir -p $BASEDIR; exit; }
MAILEE=linuxbeheer@hetcak.nl
#MAILEE=roostendorp@hetcak.nl
OUTPUT=$BASEDIR/output.log

test -f $OUTPUT && rm $OUTPUT


echo  "== Systems in the wrong Environment in relation to the hostname ==" >> $OUTPUT
echo >> $OUTPUT
echo "= ONTWIKKELING ="  >> $OUTPUT
echo >> $OUTPUT
hammer host list --search "lifecycle_environment = Ontwikkeling" | awk '{print $3}' | egrep -v "^$|^NAME|clno" >> $OUTPUT
echo >> $OUTPUT
echo "= TEST =" >> $OUTPUT
hammer host list --search "lifecycle_environment = Test" | awk '{print $3}' | egrep -v "^$|^NAME|clnt" >> $OUTPUT
echo >> $OUTPUT
echo "= ACCEPTATIE =" >> $OUTPUT
echo >> $OUTPUT
hammer host list --search "lifecycle_environment = Acceptatie" | awk '{print $3}' | egrep -v "^$|^NAME|clna|puppet" >> $OUTPUT
echo >> $OUTPUT
echo "= PRODUCTIE =" >> $OUTPUT
echo >> $OUTPUT
hammer --no-headers host list --search "lifecycle_environment = Productie" | awk '{print $3}' | egrep -v "^$|^NAME|clnp|puppet|virt-who" >> $OUTPUT >> $OUTPUT

echo >> $OUTPUT
echo "== Systems not checked in for at least 2 days ==" >> $OUTPUT
echo >> $OUTPUT
hammer --no-headers host list --search 'last_checkin <  "2 days ago"' | grep -v virt-who   | awk -F"|" '{print $2}'>> $OUTPUT


echo >> $OUTPUT
echo "== Failed tasks within the last day ==" >> $OUTPUT
hammer --no-headers --output base task list --search 'result = error and started_at > "1 days ago"' >> $OUTPUT


mailx -s "Satellite Healthcheck" $MAILEE <<EOT
`cat $OUTPUT`
EOT


#  systemd configuration for rsa_web_tier to be installed in:
#  	/opt/rsa_web_tier/rsa_web_tier (symbolic link to latest version)
#
# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
#
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>
 
[Unit]
#Description=Start RSA-WEB
#Documentation=https://docs.rsa_web_tier.org/latest/setup/install-server/#
#ConditionPathExists=/opt/rsa_web_tier/rsa_web_tier/bin/linux-x86-64/rsa-web.sh
#After=syslog.target network.target
 
[Service]
#Type=simple
#User=rsa-web
#Group=rsa-web
#PIDFile=/var/lib/rsa_web_tier/rsa_web_tier.pid
#PermissionsStartOnly=true
#ExecStart=/opt/rsa_web_tier/rsa_web_tier/bin/linux-x86-64/rsa-web.sh console
#ExecReload=/opt/rsa_web_tier/rsa_web_tier/bin/linux-x86-64/rsa-web.sh restart
#ExecStop=/opt/rsa_web_tier/rsa_web_tier/bin/linux-x86-64/rsa-web.sh stop
#@StandardOutput=syslog
#LimitNOFILE=65536
#LimitNPROC=8192
#TimeoutStartSec=50
#Restart=always
 
#[Install]
#WantedBy=multi-user.target


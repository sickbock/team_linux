# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>

<%- if @facts['os']['family'] == 'RedHat' and @facts['os']['release']['major'].to_i <= 8 -%>
HostMetadata=<%= @cmdb['role'].split(/\W/).last %> <%= @cmdb['role'].split(/\W/).first %> <% if @cmdb['params'] -%><% @cmdb['params'].each_pair do |key,value| %><%= value %> <% end %><% end %> <%= @facts['kernel'] %> <%= @facts['operatingsystem'] %> <%= @facts['operatingsystemrelease'] %>
<% else -%>
HostMetadata=<%= @cmdb['role'].split(/\W/).last %> <%= @cmdb['role'].split(/\W/).first %> <% if @cmdb['params'] -%><% @cmdb['params'].each_pair do |key,value| %><%= value %> <% end %><% end %> <%= @facts['kernel'] %> <%= @facts['os']['family'].to_s %> <%= @facts['os']['release']['full'].to_s %>
<% end -%>

Timeout=30

# Legacy UserParameters
<% @userparameters.each_pair do |key,cmd| -%>
UserParameter=<%= key %>,<%= cmd %>
<% end -%>
<% if @cmdb['applications'] -%>
UserParameter=custom.applications,echo '<% @cmdb['applications'].each_with_index do |app,i| %><%= app %><%= ', ' if i < (@cmdb['applications'].size - 1) %><% end %>'
<% else -%>
UserParameter=custom.applications,echo 'No applications in node ENC'
<% end -%>
<% if @cmdb['params'] and @cmdb['params']['dnsfuncname'] -%>
UserParameter=custom.visible_name,echo "<%= @cmdb['params']['dnsfuncname'] %>"
<% else -%>
UserParameter=custom.visible_name,echo "<%= @facts['networking']['fqdn'] %>"
<% end -%>
UserParameter=custom.puppet.tag,echo '<%= @cmdb['role'].split(/\W/).last %> <% if @cmdb['params'] -%><% @cmdb['params'].each_pair do |key,value| %><%= value %> <% end %><% end -%>'
UserParameter=custom.osrelease,echo "<%= @facts['os']['family'].to_s %><%= " " %><%= @facts['os']['release']['major'].to_s %>"
UserParameter=custom.kernel,echo "<%= @facts['kernelrelease'] %>"
UserParameter=custom.remotelog,journalctl -xeu rsyslog -o short --no-pager -S '5 minutes ago'|grep 'error opening connection to remote peer'| tail -1
# moved to Linuxbeheerscripts #UserParameter=scsi.disk.discovery,/var/CAK/zabbix/scripts/zabbix_disk_discovery.sh
UserParameter=scsi.disk.reads[*],cat /proc/diskstats | grep " $1 " | awk '{print $$4}'
UserParameter=scsi.disk.read_sectors[*],cat /proc/diskstats | grep " $1 " | awk '{print $$6}'
UserParameter=scsi.disk.read_time[*],cat /proc/diskstats | grep " $1 " | awk '{print $$7}'
UserParameter=scsi.disk.writes[*],cat /proc/diskstats | grep " $1 " | awk '{print $$8}'
UserParameter=scsi.disk.write_sectors[*],cat /proc/diskstats | grep " $1 " | awk '{print $$10}'
UserParameter=scsi.disk.write_time[*],cat /proc/diskstats | grep " $1 " | awk '{print $$11}'
UserParameter=scsi.disk.io_time[*],cat /proc/diskstats | grep " $1 " | awk '{print $$13}'
UserParameter=scsi.disk.state[*],cat /sys/block/$1/device/state 2>/dev/null || echo "removed"
UserParameter=custom.nonrepopkgs,[[ -s /var/tmp/unknown-packages-outside-repo ]] && cat /var/tmp/unknown-packages-outside-repo
UserParameter=custom.taintedmods,echo $(/usr/bin/sed -e '/([A-Za-z]*)$/!d;s/\ .* (/:/;s/).*//' /proc/modules)
UserParameter=custom.unknowntaintedmods,echo $(/usr/bin/sed -e '/([A-Za-z]*)$/!d;/^bmhook/d;/^tmhook/d;/^bmsensor/d;/^dsa_filter/d;/^oracleacfs/d;/^oracleadvm/d;/^oracleoks/d;s/\ .* (/:/;s/).*//' /proc/modules)
UserParameter=custom.nolongertainted,if [ $(/usr/bin/cat /proc/sys/kernel/tainted) -gt 0 -a "$(/usr/bin/sed -e '/([A-Za-z]*)$/!d;s/\ .* (/:/;s/).*//' /proc/modules)X" == "X" ]; then echo 1 ; else echo 0; fi
UserParameter=custom.unpackagedkernelmods,/usr/bin/sudo /usr/lib/zabbix/externalscripts/unpackagedkernelmods.sh
UserParameter=custom.dnsverify,/usr/lib/zabbix/externalscripts/dnsverify $(hostname -f) $(hostname -i)
UserParameter=custom.qlsagent,/usr/bin/sudo /usr/sbin/ausearch -ts $(/usr/bin/date --date="now -15 minutes" +"%m/%d/%Y %H:%M:%S") -te $(/usr/bin/date +"%m/%d/%Y %H:%M:%S") -ua $(/usr/bin/id -u qlsagent) 2>/dev/null |/usr/bin/wc -l
UserParameter=custom.qlsagenthealth,/usr/bin/sudo /usr/local/qualys/cloud-agent/bin/qualys-healthcheck-tool | /bin/grep "Overall Health :"|/bin/cut -c 24- 
UserParameter=custom.sattask,/usr/bin/sudo /root/git/satellite/sat_task_check.sh >/dev/null 2>&1; echo $?
UserParameter=custom.satsync,/usr/bin/sudo /root/git/satellite/sat_sync_check.sh >/dev/null 2>&1; echo $?

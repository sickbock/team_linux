#!/usr/bin/bash
# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Read <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>

#set -x

# these are taken from siem_server.yaml
RETAIN_DAYS=<%= @rsyslog_retention_days %>
ZIP_DAYS=<%= @rsyslog_zip_after_days %>

# cron stability
TEST=/usr/bin/test
ECHO=/usr/bin/echo
GREP=/usr/bin/grep
FIND=/usr/bin/find
LOGGER="/usr/bin/logger -p user.notice"
NICE=/usr/bin/nice
IONICE=/usr/bin/ionice

# script name is logger tag
TAG="$(basename $0)"

# check dirs for existence
<% @rsyslog_dirs.each do | dir | %>
${TEST} -d <%= dir %> || exit 1
<% end %>

# loop over configured dirs
${LOGGER} -t ${TAG} "housekeeping started"
for basedir in <% @rsyslog_dirs.each do | dir | %><%= dir %> <% end %> <% if @syslog_prog -%><% @syslog_prog.each do |prog| -%>/var/log/remote/<%= prog.gsub(' ','_') %> <% end -%> <% end -%>; do
 if [ -d ${basedir} ]; then
  # look for files to remove
  ${FIND} "${basedir}" -type f -name "*.log.gz" -mtime +${RETAIN_DAYS} | while read file
  do
    rm -f ${file} && ${LOGGER} -t "${TAG}" "removed file ${file} (retention is ${RETAIN_DAYS} days)"
  done

  # remove empty files and directories
  ${FIND} "${basedir}" -type f -empty -delete
  ${FIND} "${basedir}" -type d -empty -delete

  # look for files to gzip
  ${FIND} "${basedir}" -type f -name "*.log" -mtime +${ZIP_DAYS} | while read file
  do
    if [ ! -s ${file}.gz ]; then
      ${NICE} -n19 ${IONICE} -c3 gzip ${file} && ${LOGGER} -t "${TAG}" "zipped file ${file}"
    else # just hope this is not double logging
      ${NICE} -n19 ${IONICE} -c3 gzip -c ${file} >> ${file}.gz  && ${LOGGER} -t "${TAG}" "zipped file ${file}"
      rm -f ${file}
    fi
  done
 fi
done

## look for archived files to remove (remove this section & dir after 2023-07-14)
#${FIND} /var/log/remote/clnpmlg1_archief_tot_20210414/ -type f -name "*.tgz" -mtime +${RETAIN_DAYS} | while read file
#do
#  rm -f ${file} && ${LOGGER} -t "${TAG}" "removed file ${file} (retention is ${RETAIN_DAYS} days)"
#done

# Crude but effective: hard coded list of Mulesoft RTF problem makers
for rtfnode in clna22906 clnt13214 clnp33072 clno03064 clnp33069 clnp33070 clnp33071 clnp33073 clnt13203 clno03062 clno03063 clnt13213 clnt13212 clna22905 clnt13201 clnt13202 clna22904 
do
  # remove huge, double logs
  ${LOGGER} -t "${TAG}" "removed $(find /var/log/remote/syslog/messages/${rtfnode} -type f -name \*audispd.log\* -mtime +1)"
  find /var/log/remote/syslog/messages/${rtfnode} -type f -name \*audispd.log\* -mtime +1 -delete
  # remove older 
  ${LOGGER} -t "${TAG}" "removed $(find /var/log/remote/auditd/${rtfnode} -type f -name \*audispd.log\* -mtime +366)"
  find /var/log/remote/auditd/${rtfnode} -type f -name \*audispd.log\* -mtime +366 -delete
done


${LOGGER} -t ${TAG} "housekeeping done"

exit 0

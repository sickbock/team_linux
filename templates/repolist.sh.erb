<%- if @os['name'] == 'RedHat' %>
repo_source=/etc/yum.repos.d/redhat.repo
<% end %>
<%- if @os['name'] == 'CentOS' %>
repo_source=/etc/yum.repos.d/CentOS-Base.repo
<% end %>
<%- if @os['name'] == 'Trend' %> <%# CentOS "appliance" using custom OS name %>
repo_source=/etc/yum.repos.d/CentOS-Base.repo
<% end %>

if [ ! -r "${repo_source}" -o "${repo_source}X" == "X" ]; then
  exit 0
fi


separator=';'
state=0
repoid=""
reponame=""
repoenabled=0
while read line
do
  case $state in
    0)
      if [[ $line =~ ^\[ ]]; then
        state=1
        repoid=$( echo "$line" | sed 's;\[;;g' | sed 's;\];;g' )
      fi
      ;;
    1)
      if [[ $line =~ ^enabled ]]; then
        state=2
        repoenabled=$( echo "$line" | cut -d\= -f2 | sed 's; ;;g')
      fi
      ;;
    2)
      echo "${repoid}${separator}${repoenabled}"
      state=0
      ;;
  esac
done < <(cat $repo_source)

exit 0


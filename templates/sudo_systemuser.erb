################################################################################
# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
#
# Sudoers for local non-personal account <%= @s_logname %> managed by Puppet
#
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>
################################################################################
<% if @sudodefaults -%>
<% @sudodefaults.each do |setting| -%>
Defaults:<%= @s_logname %> <%= setting %>
<% end -%>
<% end -%>

<% if @sudorules -%>
<% @sudorules.each_pair do |asuser,attribs| -%>
<% if attribs['tags'] -%>
<%= @s_logname %> <%= @facts['networking']['hostname'] %>=(<%= asuser %>) <%= attribs['tags'] %> <%= attribs['commands'].join(', ') %>
<%- else -%>
<%= @s_logname %> <%= @facts['networking']['hostname'] %>=(<%= asuser %>) NOPASSWD: <%= attribs['commands'].join(', ') %>
<% end -%>
<% end -%>
<% end -%>
<% if @customsudorules -%>
<% @customsudorules.each do |customsudorule| -%>
<%= @s_logname %> <%= @facts['networking']['hostname'] %>=<%= customsudorule %>
<% end -%>
<% end -%>


## puppet master : <%= @servername %>
## puppet version: <%= @serverversion %>
## puppet module : <%= @module_name %>
## puppet class  : <%= @name %>
## do not edit this file.
## Documentation:
##  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>

# To do some condition to make sure user exists
*.warning action(type="omfile"
  action.repeatedmsgcontainsoriginalmsg="on"
  fileOwner="root"
  fileGroup="zabbix"
  fileCreateMode="0640"
  queue.type="LinkedList"
  queue.filename="zabbix_warning"
  queue.saveOnShutdown="on"
  file="/var/log/monitor-warning"
)
*.error action(type="omfile" 
  action.repeatedmsgcontainsoriginalmsg="on"
  fileOwner="root"
  fileGroup="zabbix"
  fileCreateMode="0640"
  queue.type="LinkedList"
  queue.filename="zabbix_error"
  queue.saveOnShutdown="on"
  file="/var/log/monitor-error"
)
*.crit;*.alert;*.emerg action(type="omfile"
  action.repeatedmsgcontainsoriginalmsg="on"
  fileOwner="root"
  fileGroup="zabbix"
  fileCreateMode="0640"
  queue.type="LinkedList"
  queue.filename="zabbix_critical"
  queue.saveOnShutdown="on"
  file="/var/log/monitor-critical"
)
if $programname == 'insights-client' and ($msg contains 'register' or $msg contains 'warning' or $msg contains 'error') then action(type="omfile"
  action.repeatedmsgcontainsoriginalmsg="on"
  fileOwner="root"
  fileGroup="zabbix"
  fileCreateMode="0640"
  queue.type="LinkedList"
  queue.filename="zabbix_insightsclient"
  queue.saveOnShutdown="on"
  file="/var/log/insightsclient.log"
)


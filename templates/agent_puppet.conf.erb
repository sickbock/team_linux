# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>

[main]
server = <%= @servername %>
certname = <%= @facts['networking']['fqdn'] %>
usecacheonfailure = false
<% if @puppetruntimeout -%>
runtimeout = <%= @puppetruntimeout %>
<% end -%>

[agent]
report = true
graph = true
strict_variables = true
environment = <%= @environment %>
runinterval = <%= @runinterval %>
splay = true

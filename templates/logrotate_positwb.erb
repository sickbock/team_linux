# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>
/var/log/rstudio/launcher/*.log 
{
    missingok
    notifempty
    weekly
    compress
    delaycompress
    maxage 31
    size 100M
    su root root
    create 600 rstudio-server rstudio-server
}
/var/log/rstudio/rstudio-server/*.log
{
    missingok
    notifempty
    weekly
    compress
    delaycompress
    maxage 31
    size 100M
}

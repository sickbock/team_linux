#
# https://access.redhat.com/articles/3549872#clientrhel7
# file:///usr/share/doc/rsyslog/html/tutorials/tls.html#ca-certificate
#
## /etc/rsyslog.d/remote_globals.conf
##
## Global definitions for remote message reception that cannot currently
## be handled within certain individual RainerScript blocks
##

global(
        DefaultNetstreamDriver          = "gtls"
        DefaultNetstreamDriverCAFile    = "/etc/pki/tls/syslogca/ca.pem"
        DefaultNetstreamDriverCertFile  = "/etc/rsyslog.d/host-cert.pem"
        DefaultNetstreamDriverKeyFile   = "/etc/rsyslog.d/host-key.pem"
        )

# see remotelog.conf for loading module "imtcp"

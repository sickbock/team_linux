# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Only tested/applicable for RHEL 7, 8 and 9
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>

# https://wiki.archlinux.org/title/Audit_framework
-A exclude,always -F msgtype=SERVICE_START
-A exclude,always -F msgtype=SERVICE_STOP
-A exclude,always -F msgtype=BPF

# Zabbix sudo & role change
-a exclude,always -F subj_type=zabbix_agent_t -F msgtype=USER_START
-a exclude,always -F subj_type=zabbix_agent_t -F msgtype=USER_END
-a exclude,always -F subj_type=zabbix_agent_t -F msgtype=USER_CMD
-a exclude,always -F subj_type=zabbix_agent_t -F msgtype=CRED_ACQ
-a exclude,always -F subj_type=zabbix_agent_t -F msgtype=CRED_DISP
-a exclude,always -F subj_type=zabbix_agent_t -F msgtype=USER_ACCT
-a exclude,always -F subj_type=zabbix_agent_t -F msgtype=CRED_REFR
-a exclude,always -F subj_type=init_t -F msgtype=USER_ACCT
-a exclude,always -F subj_type=init_t -F msgtype=USER_ROLE_CHANGE
-a exclude,always -F subj_type=init_t -F msgtype=USER_START
-a exclude,always -F subj_type=init_t -F msgtype=USER_END

# Zabbix permissive (lazy alternative for writing + maintaining policy)
-a exclude,always -F subj_type=zabbix_agent_t -F msgtype=AVC 
# all related sudo commands and interprete (sssd):
-a exclude,always -F subj_type=zabbix_agent_t -F exe=/usr/bin/sudo
-a exclude,always -F subj_type=zabbix_agent_t -F msgtype=SYSCALL

# root cron
-a exclude,always -F uid=0 -F subj_type=crond_t -F msgtype=CRED_REFR
-a exclude,always -F uid=0 -F subj_type=crond_t -F msgtype=CRED_ACQ
-a exclude,always -F uid=0 -F subj_type=crond_t -F msgtype=CRED_DISP
-a exclude,always -F uid=0 -F subj_type=crond_t -F msgtype=USER_ACCT
-a exclude,always -F uid=0 -F subj_type=crond_t -F msgtype=USER_START
-a exclude,always -F uid=0 -F subj_type=crond_t -F msgtype=USER_END
-a exclude,always -F uid=root -F subj_type=crond_t -F msgtype=SYSCALL
-a exclude,always -F uid=root -F subj_type=crond_t -F msgtype=LOGIN

# other root
#-a exclude,always -F uid=root -F subj_type=systemd_logind_sessions_t -F syscall=mknod 
-a exclude,always -F uid=root -F subj_type=systemd_logind_sessions_t -F msgtype=SYSCALL
-a exclude,always -F uid=root -F subj_type=systemd_logind_t -F msgtype=SYSCALL
-a exclude,always -F subj_type=init_t -F exe=/usr/lib/systemd/systemd

# other
-a exclude,always -F uid=chrony -F subj_type=chronyd_t -F msgtype=SYSCALL
-a exclude,always -F msgtype=TIME_ADJNTPVAL

# host - / role specific rules that can come after everything 
# Use the following for rules that need to come first:
# team_linux::auditd_rules:
#   'linux_000001':

# shitty software
# Qualys sudo 
-a exclude,always -F uid=qlsagent -F msgtype=CRED_REFR
-a exclude,always -F uid=qlsagent -F msgtype=CRED_ACQ
-a exclude,always -F uid=qlsagent -F msgtype=CRED_DISP
-a exclude,always -F uid=qlsagent -F msgtype=USER_ACCT
-a exclude,always -F uid=qlsagent -F msgtype=USER_START
-a exclude,always -F uid=qlsagent -F msgtype=USER_END
-a exclude,always -F uid=qlsagent -F msgtype=USER_CMD

<%- if @auditd_filter -%>
<% @auditd_filter.keys.sort.each do |filter| -%>
<%= @auditd_filter[filter] %>
<% end -%>
<% end -%>


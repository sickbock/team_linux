#! /bin/sh
################################################################################
# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>
################################################################################

# Include '-d' flag to prevent tmpwatch from removing untouched Oracle (EBS)
#   directory /usr/tmp/ebso

flags="-umc"
/usr/sbin/tmpwatch "$flags" -x /tmp/.X11-unix -x /tmp/.XIM-unix \
	-x /tmp/.font-unix -x /tmp/.ICE-unix -x /tmp/.Test-unix \
	-X '/tmp/hsperfdata_*' -X '/tmp/.hdb*lock' -X '/tmp/.sapstartsrv*.log' \
	-X '/tmp/pymp-*' 10d /tmp
/usr/sbin/tmpwatch "$flags" -d 30d /var/tmp
for d in /var/{cache/man,catman}/{cat?,X11R6/cat?,local/cat?}; do
    if [ -d "$d" ]; then
	/usr/sbin/tmpwatch "$flags" -f 30d "$d"
    fi
done

<% if @syslog_prog -%>
<% @syslog_prog.each do |prog| -%> 
template(name="Tmpl<%= prog.gsub(' ','_') %>" type="list") {
    constant(value="/var/log/remote/<%= prog.gsub(' ','_') %>/")
    property(name="hostname")
    constant(value="/")
    property(name="timereported" dateformat="year")
    constant(value="/")
    property(name="timereported" dateformat="year")
    property(name="timereported" dateformat="month")
    property(name="timereported" dateformat="day")
    constant(value="-")
    property(name="programname" SecurePath="replace")
    constant(value=".log")
    }
<% end -%>
<% end -%>



# Provides TCP syslog reception
module(load="imtcp"
  StreamDriver.Name="gtls"
  StreamDriver.Mode="1"
  StreamDriver.Authmode="anon"
)

# Adding this ruleset to process remote messages
ruleset(name="RemoteMachine"){
  # Log private authentication messages
  authpriv.*   action(type="omfile" DynaFile="TmplAuthpriv")
  # Log anything else (except mail, cron) of level info or higher.
  *.info;mail.none;authpriv.none;cron.none action(type="omfile" DynaFile="TmplMsg")
  #local3.*   action(type="omfile" DynaFile="TmplAuditd")
  #local0.*   action(type="omfile" DynaFile="TmplDeepSec")
<% if @syslog_prog -%>
<% @syslog_prog.each do |prog| -%> 
  if $syslogfacility-text == 'local0' and $msg contains '<%= prog %>' then action(type="omfile" DynaFile="Tmpl<%= prog.gsub(' ','_') %>")
& stop
<% end -%>
<% end -%>


}

# start up listener at port 514
input(type="imtcp" port="514" ruleset="RemoteMachine")

<% if @selinux -%>
# start up RELP listener at port 6514
module(load="imrelp")
input( type="imrelp"
       port="6514"
       tls = "on"
       tls.authMode = "name"
       tls.permittedPeer = ["*.cak-bz.local", "*.hetcak.nl"]

       tls.cacert      = "/etc/pki/tls/syslogca/ca.pem"
       tls.mycert      = "/etc/rsyslog.d/host-cert.pem"
       tls.myprivkey   = "/etc/rsyslog.d/host-key.pem"

       ruleset="RemoteMachine"
)
<% end -%>

# Enable UDP for legacy RHEL 6 / RHEL 7 systems
module(load="imudp")
input(type="imudp" port="514" ruleset="RemoteMachine")


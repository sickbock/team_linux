# https://access.redhat.com/solutions/392433
$MainMsgQueueSize 200000
# The Main message Queue takes log data coming in to the input chain sending it on through to the parse and filter queue. This queue needs to be big enough to allow for a high amount of log messages to queue
$MainMsgQueueHighWaterMark 120000
$MainMsgQueueDiscardMark 160000
# https://www.rsyslog.com/doc/v8-stable/configuration/global/index.html#main-queue-specific-directives
$MainMsgQueueWorkerThreads 4
# Worker threads carry out actions for various rsyslog queues, normally there is no need to run multiple worker threads in parallel
$RulesetCreateMainQueue on
# Rulesets can be used to improve performance as they create their own main message queue per ruleset. This allows for more log processing to be done simultaneously and in the end accept more log input

# RHEL 8 documentation, https://access.redhat.com/solutions/37908 & 
#     file:///usr/share/doc/rsyslog/html/configuration/templates.html
# Define templates before the rules that use them
### Per-Host Templates for Remote Systems ###
template(name="TmplAuthpriv" type="list") {
    constant(value="/var/log/remote/syslog/authpriv/")
    property(name="hostname")
    constant(value="/")
    property(name="timereported" dateformat="year")
    constant(value="/")
    property(name="timereported" dateformat="year")
    property(name="timereported" dateformat="month")
    property(name="timereported" dateformat="day")
    constant(value="-")
    property(name="programname" SecurePath="replace")
    constant(value=".log")
    }

template(name="TmplMsg" type="list") {
    constant(value="/var/log/remote/syslog/messages/")
    property(name="hostname")
    constant(value="/")
    property(name="timereported" dateformat="year")
    constant(value="/")
    property(name="timereported" dateformat="month")
    constant(value="/")
    property(name="timereported" dateformat="year")
    property(name="timereported" dateformat="month")
    property(name="timereported" dateformat="day")
    constant(value="-")
    property(name="programname" SecurePath="replace")
    constant(value=".log")
    }


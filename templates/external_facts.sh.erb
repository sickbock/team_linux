#!/bin/bash
# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Read documentation / wiki at:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>
patt="::"
repl="~"
EXTROLE="<%= @cmdb['role'] %>"
#echo "roleconfig=${EXTROLE//::/~}"
echo "roleconfig=${EXTROLE//$patt/$repl}"
echo "role=<%= @cmdb['role'] %>"
echo "team=${EXTROLE%%::*}"
if [ "${EXTROLE%%::*}" == "team_dba" ]; then
  rolename=${EXTROLE##*::}
  rolenamepart=${rolename:0:13}
  if [ "${rolenamepart}" == "oracle_rdbms_" ]; then
    orareleaseandsub=${rolename#oracle_rdbms_}
    oramajorrelease=${orareleaseandsub%%_*}
    oramajprefix=${oramajorrelease}_
    oraminorandsub=${orareleaseandsub/$oramajprefix/}
    echo "ora_role_release=${oramajorrelease}"
    echo "ora_major_release=${oramajorrelease}"
    case ${oraminorandsub} in 
      [1-9][0-9]_*)
        oraminorrelease=${oraminorandsub%%_*}
        echo "ora_minor_release=${oraminorrelease}"
        ;;
      *)
        echo "ora_minor_release=0"
        ;;
    esac
  fi
fi

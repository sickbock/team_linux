# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>
[main]
gpgcheck=1
installonly_limit=3
clean_requirements_on_remove=True
best=True
skip_if_unavailable=False
<% if @facts['ds_agent_installed'] == 'ds_agent' and @dnf_exclude -%>
exclude=<%= @dnf_exclude %> ds_agent
<% elsif @dnf_exclude -%>
exclude=<%= @dnf_exclude %>
<%- else -%>
exclude=
<%- end -%>


#!/bin/bash
################################################################################
# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
#
# Replace core functionality of "linuxaccess sudo configuration" while needed
#
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>
################################################################################
#PURPOSE:
# This script download the agent 'zips' for Trend Micro Deep security Agent
# Vervolgens wordt de GPG signed.rpm eruit gefilterd en geupload naar de satellite server.
# Hiervoor zijn 4 rpm-repos aangemaakt met repoid:
#          OLD => NEW => GPG (clnp33217)
# RHEL  6: 1871 => none 
# RHEL  7: 1751 => 27 => 421 => none
# RHEL  8: 1749 => 28 => 422 => 100
# RHEL  9: 3460 => 29 => 423 => 101
# RHEL 10:                      748
# De inhoud van deze repos kan worden opgevraagd met:
# hammer package list --repository-id <repoid>
# 20230808: UPDATED FOR NEW SATELLITE SERVER 
#######################################
set -x
appname="TrendMicro_Signed"
hstname=$(hostname)
scriptname=$(basename "$0" .sh)
# spool directory
basedir=/var/tmp/
workdir=${basedir}${appname}_${scriptname}_data/
date=`date '+%d%m%y'` #020919
#mailee=roostendorp@hetcak.nl
mailee=linuxbeheer@hetcak.nl
mailcc=mpost@hetcak.nl
mailcont=${workdir}${appname}cont
keyname=RPM-GPG-KEY-${appname^^}
keyfile=${workdir}${keyname}
log=logfile-$DATE
mailtopic="Updating ${appname} on satellite ${hstname}"
#Set Architecture
aarch="x86_64"
# tver=> TMDS major version
tver="20"
#Set CAK proxy
#export https_proxy="http://proxylb.cak-bz.local:8080"

fail_action() {
echo "" |tee -a ${mailcont}
echo "$(date +%H:%M:%S): Error: ${1}, aborting" |tee -a ${mailcont}
echo "" |tee -a  ${mailcont} 
echo "`date +%H:%M:%S`: Exiting " |tee -a ${mailcont}
mailx -s "FAILED: ${mailtopic}" ${mailee} < ${mailcont}          
exit 1
}

warn_action () {
echo "$(date +%H:%M:%S): Warning: ${1}, continuing" | tee -a ${mailcont}
}

log_action () {
echo "$(date +%H:%M:%S): Info:    ${1}" | tee -a ${mailcont}
}

test_satellite() {
set -x
ALIAS_TARGET=$(host satellite.cak-bz.local 2>/dev/null | awk '/alias for/ {print $NF}' | sed 's/\.$//')
HOSTNAME=$(hostname)

if [[ -z "${ALIAS_TARGET}" || "${ALIAS_TARGET}" != "${HOSTNAME}" ]]; then
  echo "Host ${HOSTNAME} is not known as satellite.cak-bz.local"
  exit 1
fi
}

cleanup() {
rm ${workdir}* 
}

prep() {
#Maak workdir aan en leeg
[ -d "${workdir}" ] || mkdir -p ${workdir}
cleanup
# pre-fill mailcontent
echo "Output of ${scriptname} script on Satellite server" | tee -a ${mailcont}
echo "" | tee -a ${mailcont}
}

get_files() {
log_action "Getting files..."
dltype="of unknown type" 

#get latest agent
agentstring="Agent-RedHat"
dltype="RSSfeed"
wgoutpfil="${workdir}${appname}-${dltype}-wgetoutput.txt"
dlurl="https://files.trendmicro.com/products/deepsecurity/en/DeepSecurityInventory_en.xml"
wget --directory-prefix=${workdir} -o ${wgoutpfil} ${dlurl}
[ $? != 0 ]  && warn_action "Download ${dltype} failed" 

for osver in {8..10}
do
dltype="Agent${osver}"
agentselect="EL${osver}-${tver}"
dlurl=$(grep -i download "${workdir}DeepSecurityInventory_en.xml" |grep ${aarch}|grep ${agentstring}|grep ${agentselect}|sed 's/<\/*ds:download>//g')
wgoutpfil="${workdir}${appname}-${dltype}wgetoutput.txt"
wget --directory-prefix=${workdir} -o ${wgoutpfil} ${dlurl}
[ $? != 0 ]  && warn_action "Download ${dltype} failed" 
done
}

eval_upl_files_rpm() {
#unzip
#unzipping form agent files:
log_action "Unzipping..."
cd ${workdir}
for osver in {8..10}
do
rhver="EL${osver}"
echo "${rhver}, ${tver}" 
#  pwd
#  ls -la $(pwd)
  fil2unzip="Agent-RedHat_${rhver}-${tver}*x86_64.zip"
  unzip -u ${fil2unzip} "Agent-PGPCore-RedHat_${rhver}-${tver}*.rpm" # Not unzipping "Agent-Core-RedHat_${rhver}-${tver}*.rpm" "3trend_public.asc"
  [ $? != 0 ]  && warn_action "unzipping ${fil2unzip} failed"
done

log_action "Evaluating & Uploading RPMs to yum repo"
files=${workdir}*.rpm
for line in ${files}; do
  file=$(basename ${line})
  [ -s ${line} ] || fail_action "File ${file} seems 0 bytes, please investigate"
  set id=0
  [[ ${file} =~ Agent-.*EL8.* ]] && id=100
  [[ ${file} =~ Agent-.*EL9.* ]] && id=101
  [[ ${file} =~ Agent-.*EL10.* ]] && id=748
  repofile=${file}
  log_action "Handling repo ${id}"
  hammer repository upload-content --id ${id} --path ${line} || warn_action "Upload ${line} failed, aborted"
  log_action "Most recent content of repo ${id}"
  hammer package list --repository-id ${id}| tail -4 |head -3| cut -c 10-| tee -a ${mailcont}
done
}

report () {
echo "reporting"
if grep -qi warning ${mailcont}; then
  mailurg="WARNING:"
else
  mailurg="REPORT:"
fi
echo "`date +%H:%M:%S`: Report finished" >> ${mailcont}
echo "" >> ${mailcont}
echo "Kind regards," >> ${mailcont}
echo "Your Satellite Hammer service for Trend Micro stuff" >> ${mailcont}
if [ ! -z ${mailcc} ] ; then
  mailx -s "${mailurg} ${mailtopic}" -c ${mailcc} ${mailee} < ${mailcont}
else
  mailx -s "${mailurg} ${mailtopic}" ${mailee} < ${mailcont}
fi
}
******
*MAIN
test_satellite
prep
get_files
eval_upl_files_rpm
report
cleanup
exit 0
### Finish


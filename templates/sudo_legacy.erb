################################################################################
# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
#
# Replace core functionality of "linuxaccess sudo configuration" while needed
#
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>
################################################################################
# Linux admins have all powers
<% if @sudo_root -%>
<% @sudo_root.each do |val| -%>
<%= val %> <%= @shortname %>=(ALL) NOPASSWD: ALL
<% end -%>
<% end -%>

# lookup all roles for specific groups or users
# team_linux::sudocmd
<% if @allsudocmd -%>
<% @allsudocmd.each_pair do |grantee,attr| -%>
<% attr.each_pair do |asuser,cmd| -%>
<%= grantee %> <%= @shortname %>=(<%= asuser %>) NOPASSWD: <%= cmd.join(', ') %>
<% end -%>
<% end -%>
<% end -%>

# per-user defaults
<% if @sudo_defaults -%>
<% @sudo_defaults.each_pair do |logname,attr| -%>
<% attr.each do |setting| -%>
Defaults:<%= logname %> <%= setting %>
<% end -%>
<% end -%>
<% end -%>


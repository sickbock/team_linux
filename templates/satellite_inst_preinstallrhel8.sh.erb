/usr/bin/systemctl enable runpuppet.service | /usr/bin/tee -a /var/log/patchreboot.log


/usr/bin/sleep 1

/usr/bin/echo "\$0 / \$@ / \$(date): dit script hoort eenmalig, uitsluitend bij inrichting gestart te worden" | /usr/bin/tee -a /var/log/patchreboot.log
/usr/bin/sleep 1 
/usr/bin/systemctl disable patchreboot.service | tee -a /var/log/patchreboot.log
/usr/sbin/reboot | tee -a /var/log/patchreboot.log
EOF


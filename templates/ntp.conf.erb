# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>

# Enable next tinker options:
# panic - keep ntpd from panicking in the event of a large clock skew
# when a VM guest is suspended and resumed;
# stepout - allow ntpd change offset faster
tinker panic 0

disable monitor

# Permit time synchronization with our time source, but do not
# permit the source to query or modify the service on this system.
<% @ntp_servers.each do |val| -%>
restrict <%= val %> nomodify notrap nopeer noquery
<% end -%>
restrict default ignore
restrict -6 default ignore
restrict 127.0.0.1
<%- if @tcp6enabled == 'yes' -%>
restrict -6 ::1
<%- end -%>

# Set up servers for ntpd with next options:
# server - IP address or DNS name of upstream NTP server
# iburst - allow send sync packages faster if upstream unavailable
# prefer - select preferrable server
# minpoll - set minimal update frequency
# maxpoll - set maximal update frequency
<% @ntp_servers.each do |val| -%>
server <%= val %>
<% end -%>


# Driftfile.
driftfile <%= @driftfile %>

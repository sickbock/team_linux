# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>
# /etc/profile.d/commonprofile.sh


# Set history settings:

HISTSIZE=100000000
# ISO date nd time, strip line numbers using HISTTIMEFORMAT
#HISTTIMEFORMAT=$'\r\e[K'"%F %T "
# The same, but include line numbers
HISTTIMEFORMAT="%F %T "

# Set common aliases:

alias s=sudo
alias psx='export PS_FORMAT="user:20,pid,ppid,c,start,tty,time,command"; ps ax'

<%- if @cmdb['role'] == 'team_linux::role::linuxweb' or @cmdb['role'] == 'team_system::role::systemweb' -%>
alias sudo='sudo '
alias su='su -l'
<%- end-%>

<%- if @scriptroot != 'not_set' and @user_main != 'not_set' -%>
# Set path to public CAK scripts
if ! echo $PATH | grep -q "<%= @user_paths %>" ; then
  export PATH=$PATH:<%= @user_paths %>
fi
<%- end -%>


########################################
# workaround for Puppet 6 shell initialisation:
#   commonprofile should be read before
########################################
export MANPATH=":/opt/puppetlabs/puppet/share/man"

########################################
# User settings:
########################################
currentuser=`/bin/who am i`
myusername=${currentuser%% *}
# with 'sudo -i' ${SUDO_USER} can be used

# individual log files after sudo
if [ "${myusername}" != "$LOGNAME}" ]; then
  export HISTFILE=${HISTFILE}.${myusername}
  # Save bash history no matter how many logon sessions are active.
  shopt -s histappend
  PROMPT_COMMAND="history -a;${PROMPT_COMMAND}"
fi

#  only for user(s) not wanting Emacs:
if [ "${myusername%%@*}" == "admjpoutre" -o "${myusername:0:3}" != "adm" ]; then
  set -o vi
  HISTTIMEFORMAT=$'\r\e[K'"%F %T "
fi

########################################
# Security related settings 
########################################
export LESSSECURE=1
readonly LESSSECURE


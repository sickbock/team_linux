# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>
<%- if @osfamily == 'RedHat' and @facts['os']['release']['major'].to_i < 9 -%>
#  Note: /etc/logrotate.d/rsyslog from rsyslog-logrotate RPM on RHEL 9
#  includes som files to rotate, that package doesnt exist for RHEL 8
#  So, for RHEL 8 include these log files here
/var/log/cron
/var/log/maillog
/var/log/messages
/var/log/secure
/var/log/spooler
# Non overlappin logs? RHEL 8 and later
<% end -%>
/var/log/kern.log
/var/log/auth.log
/var/log/daemon.log
/var/log/boot.log
/var/log/user.log
/var/log/debug
/var/log/localmessages
/var/log/puppet/puppet.log
<% if @syslog_prog -%>
<% @syslog_prog.each do |prog| -%>
/var/log/<%= prog.gsub(' ','_') %>
<% end -%>
<% end -%>
{
    missingok
    sharedscripts
    postrotate
        /usr/bin/systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || true
    endscript
}

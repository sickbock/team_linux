# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>

# this is the rsyslog.conf for the SIEM server, configured to -receive-
# remote and local syslogs.

# rsyslog v3: load input modules
$ModLoad imuxsock.so
$ModLoad imfile.so
$ModLoad imudp.so                  # Provides UDP syslog reception
$UDPServerRun 514                  # on this UDP port
$ModLoad imtcp.so                  # Provides TCP syslog reception
$InputTCPServerRun 514             # on this TCP port

# reduce duplicate log messages (last message repeated n times)
$RepeatedMsgReduction on

$umask 0000
$FileOwner root
$FileGroup root
$FileCreateMode 0640
$DirOwner root
$DirGroup root
$DirCreateMode 0750

# local puppet messages to local log
if $programname contains 'puppet-agent' and $hostname contains '<%= @facts['networking']['hostname'] %>'  then /var/log/puppet/puppet.log

# forward the audit log
$InputFileName /var/log/audit/audit.log
$InputFileTag tag_audit_log
$InputFileStateFile audit_log
$InputFileSeverity info
$InputFileFacility local6

$InputRunFileMonitor

$umask 0000
$FileOwner root
$FileGroup logstash
$FileCreateMode 0640
$DirOwner root
$DirGroup logstash
$DirCreateMode 0750
# audit.log messages are facility local6 (as set by sending rsyslog.conf)
# redirect to a seprate file in original format, so ausearch and aureport can be used on it
$template HostAudit, "/var/log/relk/rsyslog/nodes/%HOSTNAME%/%$YEAR%/%$MONTH%/%HOSTNAME%-%$YEAR%%$MONTH%%$DAY%-audit.log
$template auditFormat, "%msg%\n"
local6.* ?HostAudit;auditFormat

# everything else goes to syslog.log
$template RemoteHost, "/var/log/relk/rsyslog/nodes/%HOSTNAME%/%$YEAR%/%$MONTH%/%HOSTNAME%-%$YEAR%%$MONTH%%$DAY%-syslog.log"

# two cases, messages are either from this host or RemoteHost
# for RemoteHost, redirect to RemoteHost template and discard
# for local host, redirect to RemoteHost and do not discard
# so that local messages appear in the local logs
*.*;local6.none ?RemoteHost

# assemble anything but authpriv and audit (local6) messages in a central store
$template CombinedLog, "/var/log/relk/rsyslog/total/%$YEAR%/%$MONTH%/%$YEAR%%$MONTH%%$DAY%-total.log"
*.info;mail.none;authpriv.none;cron.none;local6.none ?CombinedLog

# Logstash separate file inclusion and filtering
# what is the purpose here??
#:syslogtag, isequal, "logstash:" "/var/log/%HOSTNAME%/logstash.log"

# stop processing here for all non-local messages
if $hostname != '<%= @facts['hostname'] %>' then <%= @stop_keyword %>

$umask 0000
$FileOwner root
$FileGroup root
$FileCreateMode 0640
$DirOwner root
$DirGroup root
$DirCreateMode 0750

# Log anything (except mail) of level info or higher.
# Don't log private authentication messages!
*.info;mail.none;authpriv.none;cron.none;local6.none  /var/log/messages
kern.*            /var/log/dmesg

# The authpriv file has restricted access.
authpriv.*          -/var/log/secure

# Log all the mail messages in one place.
mail.*            -/var/log/maillog

# Log cron stuff
cron.*            /var/log/cron

# Save boot messages also to boot.log
local7.*          /var/log/boot.log

#####
# CAK setings
# Add support for spooling so we will catch logging when we have no network, e.g. during startup
$WorkDirectory /var/spool/rsyslog_spool
$ActionQueueType LinkedList             # use asynchronous processing
$ActionQueueFileName srvrfwd            # set file name, also enables disk mode
$ActionResumeRetryCount -1              # infinite retries on insert failure
$ActionQueueSaveOnShutdown on           # save in-memory data if rsyslog shuts down
& <%= @stop_keyword %>

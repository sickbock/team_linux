################################################################################
# The next part of this file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
#
# Legacy soltion: HBAC should be implemented in the directory instead of here
#
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>
################################################################################
<%- if @linuxhbac == 'sshbased' %>
<%- if @root_login -%>
AllowUsers root  ansible-beheer <%= @ssh_users_join %>
AllowGroups root <%= @sshdummy %>
<%- else -%>
AllowUsers <%= @ssh_users_join %>
AllowGroups <%= @sshdummy %>
<%- end -%>
<%- elsif @linuxhbac == 'pambased' %>
UsePAM yes
<%- elsif @linuxhbac == 'sssdbased' %>
# Don't use SSH or PAM based HBAC
<%- else -%>
# No HBAC configuration known
<%- end -%>

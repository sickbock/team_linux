#EOF

#chmod u+x /root/bin/helloworld.sh

#ExecStart=/root/bin/helloworld.sh

cat << EOF > /usr/lib/systemd/system/provisioning_callback.service
[Unit]
Description=Provisioning callback service
Requires=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/curl --output-dir /usr/local/bin -O https://${SATELLITE}/pub/install/request_tower_configuration.sh 
ExecStartPre=/usr/bin/chmod 0540 /usr/local/bin/request_tower_configuration.sh
ExecStart=/usr/local/bin/request_tower_configuration.sh -s https://${AAPCTRL} -k -c  '94HWitFem,UHsuNDIS3P&EN' -t 117
ExecStartPost=/usr/bin/systemctl disable provisioning_callback.service

[Install]
WantedBy=multi-user.target

EOF

systemctl enable provisioning_callback.service

chcon -R -t bin_t /root/bin

dnf -y install openvox-agent
cat << EOF > /etc/puppetlabs/puppet/puppet.conf
[main]
server = clnp33260.cak-bz.local
certname = $(hostname -f)
usecacheonfailure = false
runtimeout = 3600

[agent]
report = true
graph = true
strict_variables = true
environment = ${CFMENV}
runinterval = 900
splay = true

EOF

/opt/puppetlabs/bin/puppet agent -t
sleep 1
/opt/puppetlabs/bin/puppet agent -t
sleep 1
systemctl enable --now puppet

sed -i 's/.*PermitRootLogin.*/PermitRootLogin no/ig' /etc/ssh/sshd_config

# For the time being, no host based firewall ... (depending on CIS hardening, Ansible management, .. this may change)
systemctl disable firewalld
systemctl mask firewalld

# Exit 0 seems a signal picked up by VRA to reboot the system and declare the system installation complete?
exit 0


dnf -y erase katello-*
dnf -y erase cloud-init
dnf -y erase perl*
rm -f /etc/sudoers.d/90-cloud-init-users
/usr/sbin/userdel -r cloud-user

dnf -y install http://${SATELLITE}/pub/katello-ca-consumer-latest.noarch.rpm
egrep "hostname.*${SATELLITE}" /etc/rhsm/rhsm.conf || \
  dnf -y install http://${SATELLITE}/pub/katello-ca-consumer-latest.noarch.rpm || \
  { echo "Failed to configure Satellite via katello-ca-consumer package" ; exit 9 ; }

#subscription-manager register --org="CAK" --activationkey="${ACTIVATION_KEY}" --force
REGISTRATION 
subscription-manager attach --auto
subscription-manager refresh
subscription-manager status
subscription-manager list
subscription-manager repos

# https://access.redhat.com/articles/simple-content-access
for i in  $(subscription-manager repos --list|awk '/Repo ID/ {print $3}') ; do subscription-manager repos --enable ${i}  ; done |tee -a ${LOG} 2>&1
# Disable Elasticsearch repos to prevent mixup of versions; version is not in packagename!
subscription-manager repos --disable CAK_Elasticsearch*

# Starting with Satellite 6.11, use Satellite client instead of tools
# https://access.redhat.com/solutions/6005561
# enable latest available Satellite tools repository

# Reeds werkend geinstalleerd op image #dnf -y install insights-client

# To Puppet or not to Puppet?
# For Puppet Enterprise: Download and execute the install script from the Puppet master:
##curl -k https://<puppetmaster>:8140/packages/current/install.bash 2>&1 |bash 2>&1 | tee -a /var/log/install_puppet 2>&1
# also  install 'at'

# To Puppet or not to Puppet?
# For Puppet Enterprise: don't upgrade puppet-agent from Satellite repo's
##/usr/bin/sed -i 's/^exclude=.*/exclude=puppet-agent/' /etc/dnf/dnf.conf

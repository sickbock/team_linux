###echo 'exclude=puppet-agent aziot-identity-service' >> /etc/dnf/dnf.conf
echo 'exclude=aziot-identity-service' >> /etc/dnf/dnf.conf

# To Puppet or not to Puppet?
##/usr/local/bin/puppet agent --disable Install

# create link for convenience
mkdir /root/bin
# To Puppet or not to Puppet?
##ln -s /opt/puppetlabs/bin/puppet /root/bin/puppet

dnf update -y

[[ $(grep -ci NISDOMAIN /etc/sysconfig/network) -eq 0 ]] && echo "NISDOMAIN=ipaprod.hetcak.nl" >> /etc/sysconfig/network

# Hard coded Kerberos configuration
cat << EOF > /etc/krb5.conf
includedir /etc/krb5.conf.d/
includedir /var/lib/sss/pubconf/krb5.include.d/

[libdefaults]
  default_realm = IPAPROD.HETCAK.NL
  dns_lookup_realm = true
  dns_lookup_kdc = true
  rdns = false
  dns_canonicalize_hostname = true
  ticket_lifetime = 24h
  forwardable = true
  udp_preference_limit = 0
  default_ccache_name = KEYRING:persistent:%{uid}


[realms]
  IPAPROD.HETCAK.NL = {
    pkinit_anchors = FILE:/var/lib/ipa-client/pki/kdc-ca-bundle.pem
    pkinit_pool = FILE:/var/lib/ipa-client/pki/ca-bundle.pem

  }


[domain_realm]
  .ipaprod.hetcak.nl = IPAPROD.HETCAK.NL
  ipaprod.hetcak.nl = IPAPROD.HETCAK.NL
  ${HOSTNAME} = IPAPROD.HETCAK.NL
  .cak-bz.local = IPAPROD.HETCAK.NL
  cak-bz.local = IPAPROD.HETCAK.NL
EOF

/usr/bin/authselect apply-changes

# Hopefully, all RHEL 8 screw ups have been corrected?
# if not, modify /etc/authselect/user-nsswitch.conf and create symbolic link
# Try authselect and hope it works the first and only time:
/usr/bin/authselect select sssd with-sudo with-mkhomedir --force
/usr/bin/systemctl enable --now oddjobd.service

# Hard coded Kerberos configuration
HOSTNAME=$(hostname -f)
cat << EOF > /etc/sssd/sssd.conf
[domain/ipaprod.hetcak.nl]
cache_credentials = True
krb5_store_password_if_offline = True
ipa_domain = ipaprod.hetcak.nl
id_provider = ipa
auth_provider = ipa
access_provider = ipa
ldap_tls_cacert = /etc/ipa/ca.crt
ipa_hostname = ${HOSTNAME}
chpass_provider = ipa
ipa_server = _srv_, clnp32797.ipaprod.hetcak.nl, clnp32798.ipaprod.hetcak.nl
dns_discovery_domain = ipaprod.hetcak.nl
default_shell = /bin/bash
override_shell = /bin/bash
fallback_homedir = /home/%u
override_homedir = /home/%u

[sssd]
services = nss, sudo, pam, ssh
domains = ipaprod.hetcak.nl

[nss]
homedir_substring = /home

[pam]

[sudo]

[autofs]

[ssh]

[pac]

[ifp]

[secrets]

[session_recording]

EOF

chmod 0600 /etc/sssd/sssd.conf

# Hopefully /etc/security/access.conf does not need modification

# Hard coded IPA installation an configuration, ... just pray it works 
/usr/sbin/ipa-client-install --hostname $(hostname -f) --domain ipaprod.hetcak.nl --realm IPAPROD.HETCAK.NL -p hostadmin -w gables-uAENtNJRfPDGV35-xi7WqWtan -N -U

# Hopefully oddjob_mkhomedir will work:
/usr/bin/authselect select sssd with-sudo with-mkhomedir --force; /bin/systemctl restart oddjobd

# To Puppet or not to Puppet?


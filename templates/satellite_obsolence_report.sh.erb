function remove_exceptions() {
for EHOST in "${RTFEXCEPTIONS[@]}"; do
  sed -i -e \/${EHOST::-1}\/d ${SATSPOOL}
done
}

function generate_output() {
#set -x
for i  in "${!RHELVERSIONS[@]}"; do
  write_mail ""
  write_mail ""
  write_mail "RHEL versie ${RHELVERSIONS[$i]} (${CAKSUPPORTS[$i]}) support eindigt op: ${OBSDATES[$i]}"
  write_mail ""
  write_mail "Hostname,Puppetrole"
  while read HOST; do
    if [ "${HOST:(-1)}" == "${RHELVERSIONS[$i]}" ]; then
      PRINTHOST=$(grep ${HOST%%,*} ${PUPSPOOL})
      if [ "${PRINTHOST}" == "" ]; then
        write_mail "${HOST%%,*}"
                #", puppet role not found."
      else
        write_mail "${PRINTHOST}"
      fi
    fi
  done<${SATSPOOL}  
done
}

function mail_header() {

write_mail "Overzicht Linux systemen met betrekking tot OS versie, einde maintenance support en puppet rol."
write_mail "Voor meer informatie over RHEL support en End of Life https://access.redhat.com/product-life-cycles?product=Red%20Hat%20Enterprise%20Linux " 
write_mail "Gegenereerd: ${DATE}"
}

function mail_footer() {
write_mail
write_mail "Legenda:"
write_mail "Runtime Fabric = Enterprise Service Bus"
write_mail "team_esb = Enterprise Service Bus"
write_mail "team_ot = Enterprise Service Bus"
write_mail "team_Redis = Redis"
write_mail "team_splunk = Splunk"
write_mail "team_dba = DBA"
write_mail "team_stc = IAM"
write_mail "team_linux = generiek (ICT Basis IAL)"
write_mail
write_mail "This mail is Generated by ICT-Basis IAL"
}

function mail_uitzonder() {
cat <<EOF >> ${MAILCONT}


De volgende lijst zijn systemen voor Runtime Fabric en als eis van leverancier op RHEL 8.6 vastgezet. Daarom ontvangen deze systemen geen patches.

EOF
for HOST in ${RTFEXCEPTIONS[@]}; do
  echo ${HOST} |tee -a ${MAILCONT} ${EXCSPOOL}
done
}

function mail_rhel7() {
cat <<EOF >> ${MAILCONT}

RHEL versie 7 (N-3) support eindigde reeds op 30 juni 2024

clna22777.cak-bz.local,cloudconnector
clnp32844.cak-bz.local,cloudconnector
(deze lijst is handmatig)
EOF
}

function mail_rhel6() {
cat <<EOF >> ${MAILCONT}

RHEL versie 6 (N-4) support eindigde reeds op 30 november 2020

Hostname,Puppetrole
clna22679.cak-bz.local,oracle_rdbms_11_2_stuk
clno02627.cak-bz.local,oracle_rdbms_11_2

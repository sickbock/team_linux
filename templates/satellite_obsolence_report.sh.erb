}

function showdata() {
#owdata_sat
echo "======"
#showdata_pup
echo "======"
#showdata_exc
echo "======"
#show_version_arrays
}



function main() {
test ${TESTRUN} = true || cleanup
test_satellite
prep
fetch_sat_data
fetch_pup_data
#fetch_exc_data
test ${TESTRUN} = true && showdata
#remove_exceptions
create_mail
send_mail
test ${TESTRUN} = true || cleanup
}

main
exit 0


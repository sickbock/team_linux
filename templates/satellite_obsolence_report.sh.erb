################################################################################
#PURPOSE:
# This script combines Red Hat version info with roles
# that were sent from the puppetmaster.
# Initial script by Rob Oostendorp
########################################################

#set -x
if test -z ${1}; then 
  CMDVAR1="EMPTY"
else
  CMDVAR1="${1}"
fi

TESTRUN=false
if test ${CMDVAR1} = "test"; then
  set -x
  TESTRUN=true
fi
	
##########
# MAIL VARIABLES
MAILFAIL="roostendorp@hetcak.nl"
MAIL2LINUX=( "roostendorp@hetcak.nl" "jpoutre@hetcak.nl" )
MAILLIST=( "tiso@hetcak.nl" "secops@hetcak.nl" "wkamp@hetcak.nl" "woosterveer@hetcak.nl" "roostendorp@hetcak.nl" "linuxbeheer@hetcak.nl")
#MAILLIST=("roostendorp@hetcak.nl" "roostendorp@hetcak.nl" "roostendorp@hetcak.nl")
MAILSUBJ="Rapportage OS EOL door $(basename "$0") vanaf $(hostname)"
#MAILATT is the variable for an attachment filename
MAILATT=""

#########
# REPORTING VARIABLES
RHELVERSIONS=(8 9)
OBSDATES=("31 mei 2029" "31 mei 2032") 
CAKSUPPORTS=("N-2" "N-1")

########
# OTHER VARIABLES
DATE=$(date +"%Y%m%d") 
DATETIME=$(date +%FT%T)
test ${TESTRUN} = true && echo ${DATE}
test ${TESTRUN} = true && echo ${DATETIME}

# Commands
HAMMER="/bin/hammer"

# 

REPORTNAME="Host - Host current release version"


# Directories & Files
SCRIPTNAME=$(basename "$0")
BASEDIR="/var/tmp/"
WORKDIR="${BASEDIR}${SCRIPTNAME}_data"
MAILCONT=${WORKDIR}/mail.content
PUPINDIR="/data/reports"
PUPDATFIL="${PUPINDIR}/pupmas-exported-roles_${DATE}.csv"
LOG=logfile-$DATE
SATSPOOL="${WORKDIR}/satspool_${DATETIME}.csv"
PUPSPOOL="${WORKDIR}/pupspool_${DATETIME}.csv"
EXCSPOOL="${WORKDIR}/excspool_${DATETIME}.csv"

##########
# SERVICE ROUTINES


function abort_all() {
echo "$(date +%H:%M:%S): Error: ${1}, aborting"
exit 1
}

function fail_action() {
echo "" |tee -a ${MAILCONT}
echo "$(date +%H:%M:%S): Error: ${1}, aborting" |tee -a ${MAILCONT}
echo "" |tee -a  ${MAILCONT} 
echo "`DATE +%H:%M:%S`: Exiting " |tee -a ${MAILCONT}
mailx -s "FAILED: ${MAILSUBJ}" ${MAILFAIL} < ${MAILCONT}          
exit 1
}

function warn_action() {
echo "$(date +%H:%M:%S): Warning: ${1}, continuing" | tee -a ${MAILCONT}
}

function log_action() {
echo "$(date +%H:%M:%S): Info:    ${1}" | tee -a ${MAILCONT}
}

function write_mail() {
LINE=${1}
test -z "${LINE}" && ${LINE=" "}
echo "${1}" | tee -a ${MAILCONT}
}

function cleanup() {
rm ${WORKDIR}/* 
}

##########
# MAIN ROUTINES

function test_satellite() {
#set -x
ALIAS_TARGET=$(host satellite.cak-bz.local 2>/dev/null | awk '/alias for/ {print $NF}' | sed 's/\.$//')
HOSTNAME=$(hostname)

if [[ -z "${ALIAS_TARGET}" || "${ALIAS_TARGET}" != "${HOSTNAME}" ]]; then
  echo "Host ${HOSTNAME} is not known as satellite.cak-bz.local"
  abort_all "Host ${HOSTNAME} is not known as satellite.cak-bz.local"
fi
}

function createdir() {
if test ! -d "${1}"; then
  mkdir -p "${1}"
fi
}

function checkdir() {
if test ! -d "${1}"; then
  fail_action "Missing/unaccessable directory: ${1}"
fi
}

function checkfil() {
if test ! -f "${1}"; then
  fail_action "Missing/unaccessable file : ${1}"
fi
}

function prep() {
# Prepare directories
MKDIRECTORIES=(${WORKDIR} ${PUPINDIR})
CKDIRECTORIES=(${BASEDIR}) 
CKDIRECTORIES=(${CKDIRECTORIES[@]}  ${MKDIRECTORIES[@]})
for DIRECTORY in ${MKDIRECTORIES[@]}
do
  createdir ${DIRECTORY}
done
for DIRECTORY in ${CHKDIRECTORIES[@]}
do
  checkdir ${DIRECTORY}
done
}

function fetch_sat_data() {
# export list of fqdn hostnames and rhel version numbers (major.minor) into csv file
readarray -t HOSTVERSION  < <(${HAMMER} report-template generate --name "${REPORTNAME}"|sed 1d|grep -v "^virt-who"|sed s/"RedHat "//g)
for HOSTLINE in ${HOSTVERSION[@]}
do
  echo ${HOSTLINE::-2} |tee -a ${SATSPOOL}
done
sed -i -e 's/\.$//' ${SATSPOOL} # quick and dirty fix for trailing dots
}

function fetch_pup_data() {
checkfil ${PUPDATFIL}
cp ${PUPDATFIL} ${PUPSPOOL}
checkfil ${PUPSPOOL}
readarray  HOSTROLE < <(cat ${PUPSPOOL})
test ${TESTRUN} = true && printf '%s\n' "${SHOSTROLE[@]}"
}


function create_mail() {
mail_header
mail_rhel6
#mail_rhel7 (RHEL 7 is er niet meer!)
mail_uitzonder
generate_output
mail_footer
}

function send_mail() {
# This routine sends the data to recepients
# Recepients are stored in array named DESTINATIONS
# This array is filled by copying in each job
DESTINATIONS=("${MAILLIST[@]}")
test ${TESTRUN} = true && DESTINATIONS=("${MAIL2LINUX[@]}")
for MAILEE in "${DESTINATIONS[@]}"
do
  if [ ! ${MAILATT} == ""]; then 
    mailx -a "${MAILATT}" -s "${MAILSUBJ}" ${MAILEE} < ${MAILCONT}
  else
    mailx -s "${MAILSUBJ}" ${MAILEE} < ${MAILCONT}
  fi
done
}


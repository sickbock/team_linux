#!/bin/bash
################################################################################
# This file is managed by
# puppet master : <%= @servername %>
# puppet version: <%= @serverversion %>
# puppet module : <%= @module_name %>
# puppet class  : <%= @name %>
# do not edit this file.
#
# Replace core functionality of "linuxaccess sudo configuration" while needed
#
# Documentation:
#  <%= @git_docurl %>/<%= @git_group %>/<%= @module_name %>/wikis/<%= @name.gsub(@module_name + "::profile::",'') %>
################################################################################
#PURPOSE:
# Script used to run hammer reports from satellite and distribute those to the relevant destinations
#set -x
VALIDOPTONS=( secops_inst_errata )
MAILFAIL="roostendorp@hetcak.nl"
MAIL2LINUX=( roostendorp@hetcak.nl )
MAIL2SECOPS=( secops@hetcak.nl roostendorp@hetcak.nl )
OPTION=${1}
MAILSUBJ="Rapportage ${OPTION} door $(basename "$0") vanaf $(hostname)"

# File locations
WORKBASE=/var/tmp
WORKDIR=${WORKBASE}/${0##*/}_${OPTION}
MAILCONT=${WORKDIR}/mailcontent_${OPTION}.tmp
MAILATTLOC=${WORKDIR}

# Commands
HAMMER=/bin/hammer
MAIL=/bin/mailx
GENREPORT="report-template generate"

# Input pre-validation
if [ -z ${1} ]; then
	echo "No options given on commandline, exiting."
	echo "Example: $ sendreports.sh secops_inst_errata"
	exit 1
fi

##########
# SERVICE ROUTINES

fail_action() {
SIGNAL=${1}
echo "" |tee -a ${MAILCONT}
echo "$(DATE +%H:%M:%S): Error: ${1}, aborting" |tee -a ${MAILCONT}
echo "" |tee -a  ${MAILCONT} 
echo "`DATE +%H:%M:%S`: Exiting " |tee -a ${MAILCONT}
echo ${SIGNAL}
if [ -z ${SIGNAL} ]; then
  mailx -s "FAILED: ${MAILTOPIC}" ${MAILFAIL} < ${MAILCONT}          
fi
exit 1
}

warn_action () {
echo "$(DATE +%H:%M:%S): Warning: ${1}, continuing" | tee -a ${MAILCONT}
}

log_action () {
echo "$(DATE +%H:%M:%S): Info:    ${1}" | tee -a ${MAILCONT}
}

mailcont_write () {
echo -e "${1}" | tee -a ${MAILCONT}
}

cleanup() {
echo "Cleanup ${WORKDIR}"
rm ${WORKDIR}/* 
}

header_mail () {
mailcont_write "Beste ontvanger,"
mailcont_write "Dit is een geautomatiseerd bericht."
}

sign_mail () {
mailcont_write "Met vriendelijke groet,"
mailcont_write "ICT Basis - Infrastructure Automation Linux"
}

##########
# ROUTINES
test_satellite() {
set -x
ALIAS_TARGET=$(host satellite.cak-bz.local 2>/dev/null | awk '/alias for/ {print $NF}' | sed 's/\.$//')
HOSTNAME=$(hostname)

if [[ -z "${ALIAS_TARGET}" || "${ALIAS_TARGET}" != "${HOSTNAME}" ]]; then
  echo "Host ${HOSTNAME} is not known as satellite.cak-bz.local"
  exit 1
fi
}

prep () {
#Maak WORKDIR aan en leeg
[ -d ${WORKDIR} ] || mkdir -p ${WORKDIR}

if [ -z "$(ls -A ${WORKDIR})" ]; then
   echo "Workdir ${WORKDIR} is empty"
else
   cleanup
fi
header_mail
}

send_mail () {
# This routine sends the data to recepients
# Recepients are stored in array named DESTINATIONS
# This array is filled by copying in each job
sign_mail
for MAILEE in "${DESTINATIONS[@]}"
do
  ${MAIL} -a "${MAILATT}" -s "${MAILSUBJ}" ${MAILEE} < ${MAILCONT}
done
}

##########
# JOBS

secops_inst_errata () {
# GEBRUIKT MAIL2SECOPS ALS MAILLIJST
DESTINATIONS=("${MAIL2SECOPS[@]}")
REPORTING="report-template generate"
FORMAT="csv"
REPORTNAME="Host - Available Errata"
MAILATT="${MAILATTLOC}/${REPORTNAME}-$(date +%F).${FORMAT}.gz"
${HAMMER} ${GENREPORT} --name "${REPORTNAME}" --gzip yes --organization "CAK" --path ${MAILATTLOC} || warn_action "Genereren report ${REPORTNAME} mislukt"
mailcont_write "Gegenereerd rapport ${REPORTNAME}-$(date +%F).${FORMAT}.gz\n"
send_mail
}


##########
# MAIN 

main () {
test_satellite
prep
echo "start main loop" 
for JOB in "${VALIDOPTONS[@]}"
do
  echo ${JOB}
  if [ ${OPTION} = ${JOB} ]; then
    echo "Processing ${JOB}"
    ${JOB}
  else
    NOMAIL=true
    fail_action NOMAIL
  fi
done
}
main
cleanup
exit 0


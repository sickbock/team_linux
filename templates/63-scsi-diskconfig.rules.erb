ACTION=="add|change", KERNEL=="sd*", ENV{DEVTYPE}=="disk", RUN+="/bin/sh -c 'cat /sys$devpath/queue/max_hw_sectors_kb > /sys$devpath/queue/max_sectors_kb'"
#This virtual guest is using a disk I/O scheduler other than noop or deadline #ACTION=="add|change", KERNEL=="sd*", ENV{DEVTYPE}=="disk", RUN+="/bin/sh -c 'echo <%= @ioscheduler %> > /sys$devpath/queue/scheduler'"
